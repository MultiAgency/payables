# Standalone contributor app. The existing legacy payout executor keeps its own service and volume.
FROM node:24-slim
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# Images build only from a release candidate: the SDK is the vendored tarball, never a dev link.
COPY scripts/release-mode.mjs ./scripts/release-mode.mjs
COPY vendor ./vendor
RUN node scripts/release-mode.mjs
RUN pnpm install --frozen-lockfile
COPY tsconfig.json ./
COPY src ./src
COPY web ./web
COPY evidence ./evidence
RUN pnpm build:web
COPY deploy ./deploy
ENV NODE_ENV=production DASHBOARD_FILE=/app/deploy/invoices.json TRUST_PROXY=true
EXPOSE 8080
CMD ["sh", "/app/deploy/invoices-entrypoint.sh"]
